PORT=8001
# Comma-separated list of frontend URLs allowed by CORS
CLIENT_URL=http://localhost:5173
# Base URL printed inside every QR code. In production this must be a domain you
# control and never change, because printed tags can't be updated.
PUBLIC_APP_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/returntag

# Run "npm run generate-secrets" and paste the output here.
# Keep ENCRYPTION_KEY safe: without it, stored finder emails can't be decrypted.
JWT_SECRET=
ENCRYPTION_KEY=
HASH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@returntag.app

# Email notifications (optional). Without SMTP, emails are printed to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ReturnTag <no-reply@returntag.app>"

# Cloudflare Turnstile CAPTCHA (optional). Leave empty to rely on honeypot + rate limits.
# Testing keys that always pass: secret 1x0000000000000000000000000000000AA, site key 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# Comma-separated emails that become admins when they register or log in
ADMIN_EMAILS=

FREE_TAG_LIMIT=5
