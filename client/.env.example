# Only needed in production (e.g. on Vercel). Locally, Vite proxies /api to http://localhost:8001
VITE_API_URL=https://your-backend.onrender.com/api

# Optional Cloudflare Turnstile site key for the finder report form.
# Must pair with TURNSTILE_SECRET_KEY on the server. Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
